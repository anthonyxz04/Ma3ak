# MA3AK environment variables — PLACEHOLDERS ONLY. Never commit real values.
# On Netlify: Site configuration → Environment variables (scope: Functions). Mark secrets as "secret".
# Locally: copy to .env and fill in, or export them in your shell.

# ---- Required ----
# 48+ random characters:  node -e "console.log(require('crypto').randomBytes(36).toString('base64'))"
SESSION_SECRET=replace-with-48-random-characters
# Public address of the site (comma-separate if you also use www). Netlify's URL is used if this is empty.
PUBLIC_ORIGIN=https://your-site.netlify.app

# ---- Database ----
# On Netlify this is automatic (Netlify Database sets NETLIFY_DB_URL). Locally, point at any Postgres:
DATABASE_URL=postgres://user:password@localhost:5432/ma3ak

# ---- First admin account (created once on first start if no admin exists; then delete ADMIN_PASSWORD) ----
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password-then-remove-it

# ---- Optional: email (https://resend.com) for password resets, quote replies and alerts ----
RESEND_API_KEY=
NOTIFY_EMAIL=you@example.com
MAIL_FROM=MA3AK <notifications@your-domain.com>

# ---- Optional: AI assistant. Without these, the built-in assistant answers from the database. ----
# AI_PROVIDER = anthropic or openai
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# ---- Optional: Google sign-in (redirect URI: https://YOUR-SITE/auth/google/callback) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional: WhatsApp Cloud API alert for every event request (approved template with 5 variables) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_TO=
WHATSAPP_TEMPLATE=
WHATSAPP_API_VERSION=v21.0

# ---- Optional tuning ----
SESSION_HOURS=8
RETENTION_DAYS=730
# Local server only
PORT=3000
DATA_DIR=./data
